# Send Signal - Environment Variables
# Copy this to .env.local and fill in real values.

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/send_signal"

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-secret-min-32-chars"

# Email / SMTP
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="noreply@sendsignal.app"

# Encryption for WhatsApp credentials
# Must be base64 and decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Meta / WhatsApp webhooks
# Required for X-Hub-Signature-256 verification.
META_APP_SECRET="replace-with-meta-app-secret"

# App
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local-only Meta mock support
ALLOW_META_MOCKS="false"
